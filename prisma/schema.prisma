generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Quest {
  id           String   @id @default(uuid())
  title        String
  description  String
  difficulty   String
  duration     String
  tags         String[]
  details      String
  requirements String[]
  createdAt    DateTime @default(now())

  @@map("quests")
}
