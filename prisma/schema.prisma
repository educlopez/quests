generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Quest {
  id          String   @id @default(uuid())
  title       String
  description String
  difficult   String
  stack       String
  createdAt   DateTime @default(now())

  @@map("quests")
}
